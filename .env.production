NVR_SERIAL_NUMBER=
NVR_MAC_ADDRESS=
NVR_ID=

MONGO_DB_NAME=surveillance-fog
MONGO_DB_HOST=localhost
MONGO_DB_PORT=27017

REDIS_HOST=localhost
REDIS_PORT=6378
REDIS_DB=1
REDIS_PASSWORD=

#MQTT_HOST="mqtt://192.168.43.225"
MQTT_HOST=localhost
